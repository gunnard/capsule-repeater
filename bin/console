#!/usr/bin/env php
<?php

// Simple PSR-4 autoloader (no composer required)
spl_autoload_register(function (string $class): void {
    $prefix = 'App\\';
    $baseDir = __DIR__ . '/../src/';
    $len = strlen($prefix);
    if (strncmp($prefix, $class, $len) !== 0) {
        return;
    }
    $relativeClass = substr($class, $len);
    $file = $baseDir . str_replace('\\', '/', $relativeClass) . '.php';
    if (file_exists($file)) {
        require $file;
    }
});

// Global composer autoloader
$globalAutoload = getenv('HOME') . '/.composer/vendor/autoload.php';
if (file_exists($globalAutoload)) {
    require $globalAutoload;
}

use App\Command\DemoCommand;
use Symfony\Component\Console\Application;

if (!class_exists(Application::class)) {
    echo "Symfony Console not found. Install with: composer require symfony/console\n";
    exit(1);
}

$app = new Application('Capsule Repeater', '0.1.0');
$app->addCommand(new DemoCommand());
$app->run();
