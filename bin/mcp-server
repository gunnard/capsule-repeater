#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * STDIO entry point for the repository MCP server.
 *
 * Runs the bundle's own `mcp:server` command so there is exactly one
 * implementation of the tool surface: the repair agent, an external MCP client
 * (Claude Code, the MCP Inspector), and this binary all see the same tools.
 */

use App\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Console\Input\ArrayInput;
use Symfony\Component\Console\Output\ConsoleOutput;
use Symfony\Component\Dotenv\Dotenv;

if (!is_file(dirname(__DIR__).'/vendor/autoload_runtime.php')) {
    fwrite(STDERR, "Run \"composer install\" first.\n");
    exit(1);
}

require dirname(__DIR__).'/vendor/autoload_runtime.php';

// A model-driven run targets a disposable copy. Honour that override before
// .env can clobber it, because the container resolves CAPSULE_SANDBOX at boot.
$agentSandbox = getenv('CAPSULE_AGENT_SANDBOX');
if (false !== $agentSandbox && '' !== trim($agentSandbox)) {
    putenv('CAPSULE_SANDBOX='.$agentSandbox);
    $_ENV['CAPSULE_SANDBOX'] = $agentSandbox;
    $_SERVER['CAPSULE_SANDBOX'] = $agentSandbox;
}

if (is_file(dirname(__DIR__).'/.env')) {
    (new Dotenv())->usePutenv()->loadEnv(dirname(__DIR__).'/.env');
}

// loadEnv must not clobber the agent override above.
if (false !== $agentSandbox && '' !== trim($agentSandbox)) {
    putenv('CAPSULE_SANDBOX='.$agentSandbox);
    $_ENV['CAPSULE_SANDBOX'] = $agentSandbox;
    $_SERVER['CAPSULE_SANDBOX'] = $agentSandbox;
}

$kernel = new Kernel($_SERVER['APP_ENV'] ?? 'dev', (bool) ($_SERVER['APP_DEBUG'] ?? false));
$application = new Application($kernel);
$application->setAutoExit(false);
$application->setCatchExceptions(false);

// STDOUT carries the protocol: anything else printed there corrupts the stream.
$input = new ArrayInput(['command' => 'mcp:server', 'name' => 'capsule']);
$output = new ConsoleOutput(ConsoleOutput::VERBOSITY_QUIET);

exit($application->run($input, $output));
