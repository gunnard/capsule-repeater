{
    "name": "gunnard/capsule-repeater",
    "description": "Agentic issue-to-patch assistant for PHP repos (Symfony AI + PHP MCP SDK)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/ai-bundle": "^0.1",
        "mcp/sdk": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src"
    }
}
