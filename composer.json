{
    "name": "gunnard/capsule-repeater",
    "description": "A verification gate for AI-written patches, built on Symfony AI and the official PHP MCP SDK",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4.1",
        "mcp/sdk": "^0.9",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-anthropic-platform": "^1.0@beta",
        "symfony/ai-bundle": "^1.0@beta",
        "symfony/ai-hugging-face-platform": "^1.0@beta",
        "symfony/ai-mcp-tool": "^1.0@beta",
        "symfony/ai-open-ai-platform": "^1.0@beta",
        "symfony/console": "^7.3",
        "symfony/dotenv": "^8.1",
        "symfony/finder": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/mcp-bundle": "^1.0@beta",
        "symfony/runtime": "^8.1",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
