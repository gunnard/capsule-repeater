# Copy to .env.local and fill in what you need. Everything here is optional
# except CAPSULE_SANDBOX, and only for the MCP tool surface.

APP_ENV=dev
APP_SECRET=change_me
APP_DEBUG=1

# Provider key, only needed for the model-driven repair loop.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CAPSULE_MODEL=claude-sonnet-4-20250514

# The repository the MCP tools operate on. Required for `debug:mcp` and
# `mcp:server`; ignored by `check` and `suite`, which take --repo.
CAPSULE_SANDBOX=
