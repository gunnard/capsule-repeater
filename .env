# Committed defaults. Override anything in .env.local (gitignored).

APP_ENV=dev
APP_SECRET=capsule_repeater_local_secret
APP_DEBUG=1

# Provider keys, only needed for the model-driven repair loop. The agent below
# points at the OpenAI platform in config/packages/ai.yaml, so the model name
# must be an OpenAI one; change both together.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CAPSULE_MODEL=gpt-4o-mini

# The repository the MCP tools operate on. `check` and `suite` do not use this:
# they take --repo explicitly.
CAPSULE_SANDBOX=fixtures/shipping
